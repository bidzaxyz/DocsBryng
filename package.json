{
  "name": "bryng-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "DOCS_BASE_PATH=/docs next dev --webpack --hostname 127.0.0.1 --port 4176",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 4176",
    "postinstall": "fumadocs-mdx",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "fumadocs-core": "16.17.9",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "16.17.9",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "^4.3.0",
    "@tailwindcss/postcss": "^4.3.0"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.13",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "7.0.2"
  }
}
